<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <extension
         point="org.eclipse.ui.startup">
      <startup class="de.tools400.java.scoped.variables.core.startup.RegisterProjectScopedVariableResolver">
      </startup>
   </extension>
   
   <extension
         point="org.eclipse.core.runtime.preferences">
      <initializer
            class="de.tools400.java.scoped.variables.core.preferences.PreferencesInitializer">
      </initializer>
   </extension>

   <extension
         point="org.eclipse.ui.preferencePages">
      <page
            class="de.tools400.java.scoped.variables.core.preferencepages.VariablesPreferencePage"
            category="org.eclipse.jdt.ui.preferences.JavaBasePreferencePage"
            name="Scoped Variables"
            id="de.tools400.java.scoped.variables.core.preferencepages.VariablesPreferencePage"/>
   </extension>

</plugin>
